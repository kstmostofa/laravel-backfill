{
    "name": "kstmostofa/laravel-backfill",
    "description": "Safe, resumable, one-off data backfills for Laravel. Keyset pagination, atomic cursor persistence, per-row error isolation, and crash recovery for bulk data changes over large tables.",
    "keywords": [
        "laravel",
        "laravel-package",
        "backfill",
        "data-migration",
        "database",
        "batch",
        "batch-processing",
        "chunking",
        "keyset-pagination",
        "resumable",
        "mysql",
        "postgresql",
        "eloquent"
    ],
    "homepage": "https://kstmostofa.github.io/laravel-backfill/",
    "license": "MIT",
    "authors": [
        {
            "name": "Md Mostafijur Rahman",
            "email": "mostofa122@mail.com",
            "homepage": "https://github.com/kstmostofa"
        }
    ],
    "support": {
        "issues": "https://github.com/kstmostofa/laravel-backfill/issues",
        "source": "https://github.com/kstmostofa/laravel-backfill",
        "docs": "https://kstmostofa.github.io/laravel-backfill/"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.13",
        "laravel/pulse": "^1.8",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required for the backfill dashboard (^3.0|^4.0)"
    },
    "autoload": {
        "psr-4": {
            "Kstmostofa\\Backfill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kstmostofa\\Backfill\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kstmostofa\\Backfill\\BackfillServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
